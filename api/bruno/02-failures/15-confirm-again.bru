meta {
  name: Talent confirms the new hire
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/hires/{{hireId}}/confirm
  body: none
  auth: bearer
}

auth:bearer {
  token: {{talentToken}}
}

tests {
  test("confirmed", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("CONFIRMED");
  });
}
