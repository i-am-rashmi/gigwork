meta {
  name: Duplicate apply is refused
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/gigs/{{gigId}}/applications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{talentToken}}
}

body:json {
  {}
}

tests {
  test("409 ALREADY_APPLIED", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal("ALREADY_APPLIED");
  });
}
