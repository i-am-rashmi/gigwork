meta {
  name: Visitor: no name, link types only
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/talent/{{talentId}}
  body: none
  auth: none
}

tests {
  test("anonymous view", function () {
    expect(res.status).to.equal(200);
    expect(res.body.firstName).to.equal(undefined);
      expect(res.body.portfolio[0].type).to.equal("INSTAGRAM");
      expect(res.body.portfolio[0].url).to.equal(undefined);
  });
}
