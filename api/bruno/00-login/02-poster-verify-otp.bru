meta {
  name: Poster: verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/otp/verify
  body: json
  auth: none
}

body:json {
  {"mobile": "{{posterMobile}}", "challengeId": "{{posterChallenge}}", "code": "{{posterOtp}}"}
}

script:pre-request {
  if (!bru.getEnvVar("posterOtp")) {
    throw new Error("Paste the code from the app log (DEV OTP ...) into the environment variable posterOtp first");
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("posterToken", res.body.accessToken);
  }
}

tests {
  test("logged in", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
  });
}

docs {
  Uses posterOtp from the environment. Codes expire after 5 minutes and work once: request a new one for another run.
}
