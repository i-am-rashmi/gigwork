meta {
  name: Third account: request OTP
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/otp/request
  body: json
  auth: none
}

body:json {
  {"mobile": "{{thirdMobile}}"}
}

script:post-response {
  bru.setVar("thirdChallenge", res.body.challengeId);
}

tests {
  test("code requested", function () {
    expect(res.status).to.equal(202);

  });
}

docs {
  Then look in the app log for the line `DEV OTP for ... is NNNNNN` (logger gigwork.dev.otp) and paste the six digits into the environment variable **thirdOtp** (environment settings, top right).
}
