meta {
  name: Poster views the Talent's contact
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/applications/{{applicationId}}/talent-contact
  body: none
  auth: bearer
}

auth:bearer {
  token: {{posterToken}}
}

tests {
  test("visible", function () {
    expect(res.status).to.equal(200);
    expect(res.body.mobile).to.be.a("string");
  });
}
