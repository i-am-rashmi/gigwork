meta {
  name: Find Indiranagar
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/localities?q=indiranagar&limit=1
  body: none
  auth: none
}

script:post-response {
  bru.setVar("lat", res.body[0].lat);
  bru.setVar("lng", res.body[0].lng);
}

tests {
  test("found", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(1);
  });
}
