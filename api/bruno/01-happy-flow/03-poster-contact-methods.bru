meta {
  name: Poster shares WhatsApp and call
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/me/contact-methods
  body: json
  auth: bearer
}

auth:bearer {
  token: {{posterToken}}
}

body:json {
  {"whatsapp": true, "call": true, "email": false}
}

tests {
  test("saved", function () {
    expect(res.status).to.equal(200);

  });
}
