meta {
  name: Talent profile: location
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/me/talent-profile/location
  body: json
  auth: bearer
}

auth:bearer {
  token: {{talentToken}}
}

body:json {
  {"point": {"lat": {{lat}}, "lng": {{lng}}}, "serviceRadiusKm": 10, "willingToTravel": true}
}

tests {
  test("saved", function () {
    expect(res.status).to.equal(200);

  });
}
