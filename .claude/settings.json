{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(cd core && ./mvnw:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(docker compose -f infra/docker-compose.yml ps:*)",
      "Bash(docker compose -f infra/docker-compose.yml up -d:*)",
      "Bash(docker compose -f infra/docker-compose.yml logs:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(docker exec:*)"
    ],
    "deny": [
      "Edit(docs/adr/**)",
      "Write(docs/adr/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout main:*)",
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Bash(docker compose -f infra/docker-compose.yml down -v:*)",
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
